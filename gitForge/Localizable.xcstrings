          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O local e o remoto divergiram. Escolha \"Pull and rebase\" ou \"Pull (only if no merge needed)\" no menu Pull."
          }
