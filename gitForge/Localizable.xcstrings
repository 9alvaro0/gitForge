    "Local changes will be lost and untracked files deleted. This can't be undone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se perderán los cambios locales y se eliminarán los archivos sin seguimiento. No se puede deshacer."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As alterações locais serão perdidas e os ficheiros não seguidos serão eliminados. Esta ação não pode ser desfeita."
          }
        }
      }
    },
    "Local changes will be reverted to the last committed version. This can't be undone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios locales se revertirán a la última versión con commit. No se puede deshacer."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As alterações locais serão revertidas para a última versão com commit. Esta ação não pode ser desfeita."
          }
        }
      }
    },
    "Local-only is reversible (re-tag the same sha). Removing from origin notifies anyone who already pulled it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo en local es reversible (vuelve a etiquetar el mismo sha). Quitarla de origin afecta a quien ya la haya descargado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas local é reversível (volte a etiquetar o mesmo sha). Removê-la de origin afeta quem já a tiver obtido."
          }
        }
      }
    },
