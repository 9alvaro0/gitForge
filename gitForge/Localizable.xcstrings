          }
        }
      }
    },
    "That stash no longer exists — it was dropped or popped elsewhere. The list has been refreshed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese stash ya no existe: se eliminó o se aplicó en otro lugar. La lista se ha actualizado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse stash já não existe — foi eliminado ou aplicado noutro local. A lista foi atualizada."
          }
        }
      }
    },
    "The API needs a token to answer; it'll be checked when you connect the first account." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La API necesita un token para responder; se comprobará al conectar la primera cuenta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A API precisa de um token para responder; será verificada quando ligar a primeira conta."
          }
        }
      }
    },
    "The `git` command-line tool was found on this Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha encontrado la herramienta de línea de comandos `git` en este Mac."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ferramenta de linha de comandos `git` foi encontrada neste Mac."
          }
        }
      }
    },
    "The account's token couldn't be read from the Keychain." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido leer el token de la cuenta del llavero."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler o token da conta do porta-chaves."
          }
        }
      }
    },
    "The account's token isn't allowed to list repositories. Check its scopes." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El token de la cuenta no tiene permiso para listar repositorios. Revisa sus permisos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O token da conta não tem permissão para listar repositórios. Verifique os âmbitos."
          }
        }
      }
    },
    "The account's token isn't available. Refresh the list." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El token de la cuenta no está disponible. Actualiza la lista."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O token da conta não está disponível. Atualize a lista."
          }
        }
      }
    },
    "The account's token was rejected. Sign in again to list %@." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha rechazado el token de la cuenta. Vuelve a iniciar sesión para listar %@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O token da conta foi rejeitado. Inicie sessão novamente para listar %@."
          }
        }
      }
    },
    "The code expired before it was approved. Start again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El código caducó antes de aprobarse. Vuelve a empezar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O código expirou antes de ser aprovado. Comece novamente."
          }
        }
      }
    },
    "The file is reverted to HEAD. Any resolution you made in it is lost. This can't be undone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo se revierte a HEAD. Se perderá cualquier resolución que hayas hecho en él. No se puede deshacer."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ficheiro é revertido para HEAD. Qualquer resolução feita nele será perdida. Esta ação não pode ser desfeita."
          }
        }
      }
    },
    "The file was moved without content changes." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo se movió sin cambios de contenido."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ficheiro foi movido sem alterações de conteúdo."
          }
        }
      }
    },
    "The file will be removed from disk. This can't be undone from the app." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo se eliminará del disco. No se puede deshacer desde la app."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ficheiro será removido do disco. Não é possível desfazer a partir da app."
          }
        }
      }
    },
    "The git command failed without a message." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El comando de git ha fallado sin ningún mensaje."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O comando git falhou sem qualquer mensagem."
          }
        }
      }
    },
    "The host refused your SSH key. Run `ssh-add -l` to confirm it's loaded, or `ssh -T git@<host>` to test it. If the key has a passphrase, the agent needs it unlocked before the app can use it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El host ha rechazado tu clave SSH. Ejecuta `ssh-add -l` para confirmar que está cargada, o `ssh -T git@<host>` para probarla. Si la clave tiene frase de contraseña, el agente debe tenerla desbloqueada para que la app pueda usarla."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O host recusou a chave SSH. Execute `ssh-add -l` para confirmar que está carregada, ou `ssh -T git@<host>` para a testar. Se a chave tiver frase-passe, o agente tem de a ter desbloqueada para que a app a possa usar."
          }
        }
      }
    },
    "The host refused: %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor lo ha rechazado: %@"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor recusou: %@"
          }
        }
      }
    },
    "The instance is removed from gitForge." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La instancia se eliminará de gitForge."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A instância é removida do gitForge."
          }
        }
      }
    },
    "The operation was cancelled." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha cancelado la operación."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A operação foi cancelada."
          }
        }
      }
    },
    "The pull would overwrite these files. Their local changes will be lost:" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pull sobrescribiría estos archivos. Se perderán sus cambios locales:"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O pull substituiria estes ficheiros. As alterações locais serão perdidas:"
          }
        }
      }
    },
    "The remote has commits you don't have locally. Pull first to merge or rebase, then push again — or use Force-push (with lease) if you intentionally rewrote local history." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El remoto tiene commits que no tienes en local. Haz pull primero para fusionar o hacer rebase y vuelve a hacer push, o usa Force-push (with lease) si reescribiste el historial local a propósito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O remoto tem commits que não existem localmente. Faça pull primeiro para integrar ou fazer rebase e volte a fazer push — ou use Force-push (with lease) se reescreveu o histórico local intencionalmente."
          }
        }
      }
    },
    "The remote rejected the push because the branch is protected by repository policy (required reviews, status checks, signed commits, etc.). Open a pull request instead." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El remoto ha rechazado el push porque la rama está protegida por la política del repositorio (revisiones obligatorias, comprobaciones de estado, commits firmados, etc.). Abre un pull request en su lugar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O remoto rejeitou o push porque o ramo está protegido pela política do repositório (revisões obrigatórias, verificações de estado, commits assinados, etc.). Abra um pull request em alternativa."
          }
        }
      }
    },
    "The remote service is down or overloaded. Retry in a few minutes." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servicio remoto no funciona o está sobrecargado. Reinténtalo en unos minutos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O serviço remoto está em baixo ou sobrecarregado. Tente novamente dentro de alguns minutos."
          }
        }
      }
    },
    "The server answered %lld at %@. Check the address and the API URL." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor respondió %1$lld en %2$@. Comprueba la dirección y la URL de la API."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor respondeu %1$lld em %2$@. Verifique o endereço e o URL da API."
          }
        }
      }
    },
    "The server answered with an error (%lld)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor ha respondido con un error (%lld)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor respondeu com um erro (%lld)."
          }
        }
      }
    },
    "The server refused the sign-in (%@)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor ha rechazado el inicio de sesión (%@)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor recusou o início de sessão (%@)."
          }
        }
      }
    },
    "The server's SSL certificate isn't trusted. Often a captive portal (airport/coffee shop Wi-Fi), a MITM proxy, or a self-signed enterprise cert. Verify the network is what you expect before retrying." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El certificado SSL del servidor no es fiable. Suele deberse a un portal cautivo (Wi-Fi de aeropuerto o cafetería), un proxy MITM o un certificado empresarial autofirmado. Comprueba que la red es la que esperas antes de reintentar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O certificado SSL do servidor não é fidedigno. Muitas vezes trata-se de um portal cativo (Wi-Fi de aeroporto ou café), um proxy MITM ou um certificado empresarial autoassinado. Verifique se a rede é a esperada antes de tentar novamente."
          }
        }
      }
    },
    "The server's answer couldn't be read." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido leer la respuesta del servidor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler a resposta do servidor."
          }
        }
      }
    },
    "The server's certificate isn't trusted: %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El certificado del servidor no es fiable: %@"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O certificado do servidor não é fidedigno: %@"
          }
        }
      }
    },
    "The session expired. Reconnect the account." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sesión ha caducado. Vuelve a conectar la cuenta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sessão expirou. Volte a ligar a conta."
          }
        }
      }
    },
    "The sign-in was declined in the browser." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha rechazado el inicio de sesión en el navegador."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O início de sessão foi recusado no navegador."
          }
        }
      }
    },
    "The token doesn't have permission to read pull requests for this repo." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El token no tiene permiso para leer los pull requests de este repositorio."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O token não tem permissão para ler os pull requests deste repositório."
          }
        }
      }
    },
    "The token has been revoked or is no longer active." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El token se ha revocado o ya no está activo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O token foi revogado ou já não está ativo."
          }
        }
      }
    },
    "The token is missing these scopes: %@." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al token le faltan estos ámbitos: %@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faltam estes âmbitos ao token: %@."
          }
        }
      }
    },
    "The token isn't allowed to read your user. Check its scopes." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El token no tiene permiso para leer tu usuario. Revisa sus ámbitos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O token não tem permissão para ler o utilizador. Verifique os âmbitos."
          }
        }
      }
    },
    "The token used for this remote lacks the `%@` scope this operation needs. If it's a gitForge account, reconnect it to grant the scope; if it comes from your credential helper, replace it with a token that has it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al token usado para este remoto le falta el ámbito `%@` que necesita esta operación. Si es una cuenta de gitForge, vuelve a conectarla para conceder el ámbito; si viene de tu asistente de credenciales, sustitúyelo por un token que lo tenga."
          }
        },
