    "git records your name and email on every commit. This writes to `~/.gitconfig` and applies to every repository." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "git registra tu nombre y correo en cada commit. Esto se guarda en `~/.gitconfig` y se aplica a todos los repositorios."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O git regista o seu nome e e-mail em cada commit. Isto é escrito em `~/.gitconfig` e aplica-se a todos os repositórios."
          }
        }
      }
    },
    "gitForge %@ couldn’t be installed. Download it from GitHub and replace the app in Applications." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido instalar gitForge %@. Descárgalo de GitHub y sustituye la app en Aplicaciones."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível instalar o gitForge %@. Transfira-o do GitHub e substitua a app em Aplicações."
          }
        }
      }
    },
    "gitForge %@ is ready. Restart now to install it, or it installs when you quit." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gitForge %@ está listo. Reinicia ahora para instalarlo o se instalará al salir."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O gitForge %@ está pronto. Reinicie agora para o instalar ou será instalado ao sair."
          }
        }
      }
    },
    "gitForge %@. Checks for updates every 6 hours." : {
      "localizations" : {
